# Runtime
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
LEXORA_PUBLIC_APP_ORIGIN=http://localhost:5173

# Database
# Development defaults to sqlite:.local/lexora-platform.sqlite when omitted.
# Production requires a managed PostgreSQL URL.
DATABASE_URL=sqlite:.local/lexora-platform.sqlite

# Security: set a high-entropy secret in the deployment secret manager.
LEXORA_JWT_SECRET=replace-with-a-long-random-secret
LEXORA_JWT_ISSUER=lexora-api
LEXORA_JWT_AUDIENCE=lexora-mobile
LEXORA_ACCESS_TOKEN_MINUTES=15
LEXORA_REFRESH_TOKEN_DAYS=30

# Privacy and retention
LEXORA_DATA_REGION=us
LEXORA_MINIMUM_AGE=13
LEXORA_PARENTAL_CONSENT_ENABLED=false
LEXORA_COACH_RETENTION_DAYS=90

# Secure AI gateway. Never expose these values to an Android APK or browser bundle.
LEXORA_AI_GATEWAY_URL=
LEXORA_AI_GATEWAY_TOKEN=
LEXORA_AI_MODEL=
LEXORA_AI_TIMEOUT_MS=20000

# Social OAuth provider settings. Configure secrets only in the deployment environment.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_REDIRECT_URI=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_REDIRECT_URI=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_REDIRECT_URI=

# Optional first admin for a local/staging environment. Do not commit a value.
LEXORA_BOOTSTRAP_ADMIN_EMAIL=
LEXORA_BOOTSTRAP_ADMIN_PASSWORD=
